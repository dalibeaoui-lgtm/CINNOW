{
  "name": "cinnow",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "npm install --prefix backend --no-audit --no-fund",
    "dev": "concurrently --names api,site --prefix-colors yellow,cyan --kill-others \"npm run api\" \"ng serve\"",
    "api": "npm run dev --prefix backend",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:api": "npm test --prefix backend",
    "test:tout": "ng test --watch=false && npm test --prefix backend"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "concurrently": "^9.2.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
